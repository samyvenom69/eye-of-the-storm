# Eye of the Storm — API Keys Configuration
# Copy this file to .env and fill in your keys
# All keys are OPTIONAL — the framework works without them (reduced features)

# IP Geolocation — https://ipinfo.io/account (50k req/month free)
IPINFO_TOKEN=your_ipinfo_token_here

# Abuse IP Database — https://www.abuseipdb.com (1000 req/day free)
ABUSEIPDB_KEY=your_abuseipdb_key_here

# HaveIBeenPwned — https://haveibeenpwned.com/API (email breach detection)
HIBP_API_KEY=your_hibp_api_key_here

# Shodan — https://shodan.io (network intelligence)
SHODAN_API_KEY=your_shodan_api_key_here

# VirusTotal — https://www.virustotal.com (threat intelligence, 4 req/min free)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
